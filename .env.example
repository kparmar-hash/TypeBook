# Typebook environment template. Copy to `.env` and fill in; never commit `.env`.
#   cp .env.example .env && chmod 600 .env
#
# Only PUBLIC values belong here. Vite embeds every VITE_* variable into the built app, so anything
# in this file ends up readable by whoever has the app. Row Level Security (RLS) on the database,
# plus user sign-in, is what actually protects the data.
#
# NEVER put any of these in this file or in the app:
#   - the `service_role` key / a key starting with `sb_secret_`   (bypasses RLS: full database access)
#   - the database password or a postgres:// connection string
#   - your Supabase account access token
# Admin tasks (migrations, seeding) use those from your own shell or CI secrets, outside this project.

# Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> the PUBLISHABLE key (`sb_publishable_...`),
# or the legacy `anon` key. Safe to ship only because RLS is enabled on every table.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
